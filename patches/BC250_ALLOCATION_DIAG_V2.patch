new file mode 100644
--- /dev/null
+++ b/driver/umd/d3d12/allocation-diag-policy.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace bc250_allocdiag {
+// One independent, renewing quota per event category. No allocation or locks.
+class Budget {
+    std::atomic<std::uint64_t> state_{0};
+public:
+    // 1: event, 2: one suppression marker, 0: skip. The caller supplies monotonic minutes.
+    unsigned take(std::uint32_t minute, unsigned limit) noexcept {
+        auto old = state_.load(std::memory_order_relaxed);
+        for (;;) {
+            const auto epoch = static_cast<std::uint32_t>(old >> 32);
+            // A delayed thread must not reset a newer epoch back to an older one.
+            const auto effective = minute > epoch ? minute : epoch;
+            const auto count = effective != epoch ? 0u : static_cast<std::uint32_t>(old);
+            if (count > limit) return 0;
+            const auto next = (std::uint64_t(effective) << 32) | (count + 1u);
+            if (state_.compare_exchange_weak(old, next, std::memory_order_relaxed))
+                return count < limit ? 1u : 2u;
+        }
+    }
+};
+// Only a loss already latched by the shell changes an allocation failure.
+// Ordinary OOM and other original results retain their existing semantics.
+constexpr std::int32_t descriptor_failure(std::int32_t original, bool lost) noexcept {
+    return lost ? static_cast<std::int32_t>(0x88760870u) : original;
+}
+}
diff --git a/driver/umd/d3d12/allocation-diag.h b/driver/umd/d3d12/allocation-diag.h
new file mode 100644
--- /dev/null
+++ b/driver/umd/d3d12/allocation-diag.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "allocation-diag-policy.h"
+#include <windows.h>
+#include <cstdarg>
+#include <cstdio>
+#include <limits>
+
+namespace bc250_allocdiag {
+enum class Channel : unsigned { Command, Descriptor, Resource, Hosted, Snapshot, Begin, Count };
+inline Budget budgets[static_cast<unsigned>(Channel::Count)];
+inline std::atomic<unsigned long long> sequence{0};
+inline thread_local unsigned long long request = 0;
+class Request {
+    unsigned long long previous_ = request;
+public:
+    Request() noexcept { request = sequence.fetch_add(1, std::memory_order_relaxed) + 1; }
+    ~Request() { request = previous_; }
+    Request(const Request&) = delete;
+    Request& operator=(const Request&) = delete;
+};
+inline void emitv(Channel channel, const char* format, va_list args) noexcept {
+    const auto decision = budgets[static_cast<unsigned>(channel)].take(
+        static_cast<std::uint32_t>(GetTickCount64() / 60000), 64);
+    if (!decision) return;
+    char text[640]{}, line[832]{};
+    if (decision == 2) std::snprintf(text, sizeof(text), "channel=%u suppressed_until_next_minute limit=64", unsigned(channel));
+    else std::vsnprintf(text, sizeof(text), format, args);
+    LARGE_INTEGER now{};
+    QueryPerformanceCounter(&now);
+    std::snprintf(line, sizeof(line), "BC250-ALLOCDIAG v=2 pid=%lu tid=%lu qpc=%lld request=%llu %s\n",
+        GetCurrentProcessId(), GetCurrentThreadId(), now.QuadPart, request, text);
+    OutputDebugStringA(line);
+}
+inline void emit(Channel channel, const char* format, ...) noexcept {
+    va_list args; va_start(args, format); emitv(channel, format, args); va_end(args);
+}
+// At most one process VA walk per minute, only after a failed create. These
+// observations do not decide whether an allocation is legal or whether to retry.
+inline void memory_snapshot() noexcept {
+    static Budget samples;
+    if (samples.take(static_cast<std::uint32_t>(GetTickCount64() / 60000), 1) != 1) return;
+    MEMORYSTATUSEX memory{}; memory.dwLength = sizeof(memory);
+    const BOOL valid = GlobalMemoryStatusEx(&memory);
+    SYSTEM_INFO info{}; GetSystemInfo(&info);
+    auto address = reinterpret_cast<std::uintptr_t>(info.lpMinimumApplicationAddress);
+    const auto last = reinterpret_cast<std::uintptr_t>(info.lpMaximumApplicationAddress);
+    unsigned long long free_bytes = 0, largest = 0, committed = 0, reserved = 0;
+    bool complete = false;
+    while (address <= last) {
+        MEMORY_BASIC_INFORMATION region{};
+        if (!VirtualQuery(reinterpret_cast<void*>(address), &region, sizeof(region))) break;
+        const auto bytes = static_cast<unsigned long long>(region.RegionSize);
+        if (region.State == MEM_FREE) { free_bytes += bytes; if (bytes > largest) largest = bytes; }
+        else if (region.State == MEM_COMMIT) committed += bytes;
+        else if (region.State == MEM_RESERVE) reserved += bytes;
+        const auto base = reinterpret_cast<std::uintptr_t>(region.BaseAddress);
+        if (!region.RegionSize) break;
+        if (region.RegionSize > (std::numeric_limits<std::uintptr_t>::max)() - base) { complete = true; break; }
+        const auto next = base + region.RegionSize;
+        if (next <= address) break;
+        if (next > last) { complete = true; break; }
+        address = next;
+    }
+    emit(Channel::Snapshot, "cpu_memory valid=%u va_complete=%u pointer_bits=%u physical_available=%llu "
+        "commit_available=%llu virtual_available=%llu va_free=%llu va_largest_free=%llu va_committed=%llu va_reserved=%llu",
+        unsigned(valid != FALSE), unsigned(complete), unsigned(sizeof(void*) * 8), memory.ullAvailPhys,
+        memory.ullAvailPageFile, memory.ullAvailVirtual, free_bytes, largest, committed, reserved);
+}
+}
