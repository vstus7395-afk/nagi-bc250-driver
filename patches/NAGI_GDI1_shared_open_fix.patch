+/* A GDI standard shared texture has no E26R resource record. Its KMD allocation record is instead
+ * LB7A v1 followed by the 16-byte GDI1 trailer. Do not treat every missing E26R as a texture: admit
+ * only GDISURFACETYPE_TEXTURE (type 1), whose allocation geometry and composed format can be
+ * independently reconstructed from the KMD's own GDI layout rule. The resulting D3D12 description
+ * is deliberately copy-only (no bind flags); callers must not infer render-target or shader usage. */
+#define BC250_SHARED_SURFACE_WHY_GDI_RECORD "GDI allocation record"
+static __inline int Bc250SharedSurfaceDecodeGdi(const void *AllocationData, unsigned int AllocationBytes,
+                                                BC250_SHARED_SURFACE *Out, const char **Why)
+{
+    BC250_GDI_PRIVATE gdi;
+    const AMDGPU_WDDM_SURFACE_FORMAT *row;
+    BC250_GDI_ALLOCATION_POLICY policy;
+    unsigned long expected_pitch = 0;
+    unsigned long long expected_size = 0;
+    unsigned long long aligned_width, aligned_height;
+    BC250_SHARED_SURFACE out;
+    const char *why = BC250_SHARED_SURFACE_WHY_ARGUMENTS;
+    int status = BC250_SHARED_SURFACE_MALFORMED;
+    unsigned int i;
+    const unsigned char *src;
+    unsigned char *dst;
+    if (!Out || !AllocationData) goto done;
+    why = BC250_SHARED_SURFACE_WHY_ALLOCATION_LENGTH;
+    if (AllocationBytes != (unsigned int)sizeof(gdi)) goto done;
+    src = (const unsigned char *)AllocationData;
+    dst = (unsigned char *)&gdi;
+    for (i = 0; i < (unsigned int)sizeof(gdi); ++i) dst[i] = src[i];
+    why = BC250_SHARED_SURFACE_WHY_ALLOCATION_RECORD;
+    if (gdi.Surface.Magic != BC250_WDDM_ALLOCATION_PRIVATE_MAGIC || gdi.Surface.Version != 1 ||
+        gdi.Magic != BC250_GDI_PRIVATE_MAGIC || gdi.Flags || gdi.Reserved) goto done;
+    /* Type 1 is the only GDI allocation class whose KMD contract describes a shareable texture.
+     * Staging, shadow, primary and unknown GDI types are not texture-open fallbacks. */
+    why = BC250_SHARED_SURFACE_WHY_POLICY;
+    if (gdi.Type != 1 || !WddmGdiAllocationPolicy(gdi.Type, 0, 0, &policy)) goto done;
+    why = BC250_SHARED_SURFACE_WHY_EXTENT;
+    if (!gdi.Surface.Width || !gdi.Surface.Height ||
+        gdi.Surface.Width > BC250_SHARED_MAX_EDGE || gdi.Surface.Height > BC250_SHARED_MAX_EDGE) goto done;
+    why = BC250_SHARED_SURFACE_WHY_FORMAT;
+    row = amdgpu_wddm_surface_admit(amdgpu_wddm_surface_format_by_d3dddi((unsigned int)gdi.Surface.Format),
+                                    AMDGPU_WDDM_SURFACE_COMPOSED);
+    if (!row || !row->dxgi) goto done;
+    why = BC250_SHARED_SURFACE_WHY_ALLOCATION_GEOMETRY;
+    /* Type 1's KMD layout is DcnPrimaryPitch(width) by height rounded to four rows. Keep this
+     * arithmetic here instead of calling the KMD's DcnSharedTextureLayout: this contract is also
+     * linked into the user-mode driver, which must not acquire a dependency on KMD object code. */
+    why = BC250_SHARED_SURFACE_WHY_ALLOCATION_GEOMETRY;
+    if (row->bytes_per_pixel != 4 || !Bc250SharedSurfaceGeometry(&gdi.Surface, row->bytes_per_pixel)) goto done;
+    aligned_width = ((unsigned long long)gdi.Surface.Width + 63ull) & ~63ull;
+    aligned_height = ((unsigned long long)gdi.Surface.Height + 3ull) & ~3ull;
+    if (!aligned_width || aligned_width > 0xffffffffull / 4ull) goto done;
+    expected_pitch = (unsigned long)(aligned_width * 4ull);
+    expected_size = (unsigned long long)expected_pitch * aligned_height;
+    if (gdi.Surface.Pitch != expected_pitch || gdi.Surface.Size != expected_size) goto done;
+    out.Width = gdi.Surface.Width;
+    out.Height = gdi.Surface.Height;
+    out.Pitch = gdi.Surface.Pitch;
+    out.DxgiFormat = row->dxgi;
+    out.D3dDdiFormat = gdi.Surface.Format;
+    out.BindFlags = 0;
+    out.BytesPerPixel = row->bytes_per_pixel;
+    out.Size = gdi.Surface.Size;
+    out.MiscFlags = 0;
+    out.Shared = 1;
+    out.Access = 0;
+    *Out = out;
+    why = BC250_SHARED_SURFACE_WHY_GDI_RECORD;
+    status = BC250_SHARED_SURFACE_OK;
+done:
+    if (Why) *Why = why;
+    return status;
+}
