diff --git a/driver/contract/bc250_shared_surface.h b/driver/contract/bc250_shared_surface.h
index 88c57a8b..e99486e2 100644
--- a/driver/contract/bc250_shared_surface.h
+++ b/driver/contract/bc250_shared_surface.h
@@ -100,6 +100,26 @@ typedef struct _BC250_SHARED_SURFACE {
     unsigned long Access;
 } BC250_SHARED_SURFACE;
 
+/* KMD CreateAllocation preserves the logical LB7A Size but gives VidMm whole 4096-byte pages.
+ * Check the engine's complete backing against those pages, without relaxing row-pitch agreement.
+ * Keep this arithmetic 64-bit in the WoW64 UMD too. Zero and overflowing sizes are not allocations.
+ * AllocationBytes is diagnostic output only, and is zero on an invalid logical size. */
+static __inline int Bc250SharedSurfaceLayoutFits(const BC250_SHARED_SURFACE *Surface,
+                                                unsigned long long EnginePitch,
+                                                unsigned long long EngineBytes,
+                                                unsigned long long *AllocationBytes)
+{
+    unsigned long long bytes;
+    if (AllocationBytes)
+        *AllocationBytes = 0;
+    if (!Surface || !Surface->Size || Surface->Size > ~0ull - 4095ull)
+        return 0;
+    bytes = (Surface->Size + 4095ull) & ~4095ull;
+    if (AllocationBytes)
+        *AllocationBytes = bytes;
+    return EnginePitch && EnginePitch == Surface->Pitch && EngineBytes && EngineBytes <= bytes;
+}
+
 /* Which records an opener admits. RequireShared 1 takes only a record that shares; AccessMask is
  * the set of BC250_SURFACE_RESOURCE_* access bits it admits (0: a plain texture only). */
 typedef struct _BC250_SHARED_SURFACE_ADMIT {
@@ -342,6 +362,88 @@ static __inline int Bc250SharedSurfaceDecodeWhy(const void *ResourceData, unsign
                                           Why);
 }
 
+/* BD-253 / D3D9On12 interop: decodes a bare allocation where the runtime handed no resource record
+ * (ResourceBytes == 0), as D3D9On12, GDI texture swapchains and Qt backing stores do.
+ * Admits a 48-byte BC250_GDI_PRIVATE (GDI texture, Type 1) or a 32-byte BC250_WDDM_ALLOCATION_PRIVATE (LB7A v1). */
+static __inline int Bc250SharedSurfaceDecodeBareAllocation(const void *AllocationData, unsigned int AllocationBytes,
+                                                          BC250_SHARED_SURFACE *Out, const char **Why)
+{
+    BC250_GDI_PRIVATE blob;
+    const AMDGPU_WDDM_SURFACE_FORMAT *row = 0;
+    const char *why = BC250_SHARED_SURFACE_WHY_ARGUMENTS;
+    int status = BC250_SHARED_SURFACE_MALFORMED;
+    unsigned int i;
+    unsigned char *dst;
+
+    dst = (unsigned char *)&blob;
+    for (i = 0; i < (unsigned int)sizeof(blob); ++i)
+        dst[i] = 0;
+
+    for (;;) {
+        if (!Out || !AllocationData)
+            break;
+        why = BC250_SHARED_SURFACE_WHY_ALLOCATION_LENGTH;
+        if (AllocationBytes == (unsigned int)sizeof(BC250_GDI_PRIVATE)) {
+            const unsigned char *src = (const unsigned char *)AllocationData;
+            for (i = 0; i < (unsigned int)sizeof(blob); ++i)
+                dst[i] = src[i];
+            why = BC250_SHARED_SURFACE_WHY_ALLOCATION_RECORD;
+            if (blob.Magic != BC250_GDI_PRIVATE_MAGIC || blob.Type != 1ul /* D3DKMDT_GDISURFACE_TEXTURE */ ||
+                blob.Flags || blob.Reserved)
+                break;
+        } else if (AllocationBytes == (unsigned int)sizeof(BC250_WDDM_ALLOCATION_PRIVATE)) {
+            const unsigned char *src = (const unsigned char *)AllocationData;
+            for (i = 0; i < (unsigned int)sizeof(blob.Surface); ++i)
+                dst[i] = src[i];
+        } else {
+            break;
+        }
+
+        why = BC250_SHARED_SURFACE_WHY_ALLOCATION_RECORD;
+        if (blob.Surface.Magic != BC250_WDDM_ALLOCATION_PRIVATE_MAGIC || blob.Surface.Version != 1)
+            break;
+
+        why = BC250_SHARED_SURFACE_WHY_FORMAT;
+        row = amdgpu_wddm_surface_admit(amdgpu_wddm_surface_format_by_d3dddi((unsigned int)blob.Surface.Format),
+                                        AMDGPU_WDDM_SURFACE_COMPOSED);
+        if (!row || !row->dxgi) {
+            status = BC250_SHARED_SURFACE_FORMAT;
+            break;
+        }
+
+        why = BC250_SHARED_SURFACE_WHY_EXTENT;
+        if (!blob.Surface.Width || !blob.Surface.Height ||
+            blob.Surface.Width > BC250_SHARED_MAX_EDGE || blob.Surface.Height > BC250_SHARED_MAX_EDGE)
+            break;
+
+        why = BC250_SHARED_SURFACE_WHY_ALLOCATION_GEOMETRY;
+        if (!Bc250SharedSurfaceGeometry(&blob.Surface, row->bytes_per_pixel))
+            break;
+
+        status = BC250_SHARED_SURFACE_OK;
+        why = BC250_SHARED_SURFACE_WHY_OK;
+        break;
+    }
+
+    if (Why)
+        *Why = why;
+    if (status != BC250_SHARED_SURFACE_OK)
+        return status;
+
+    Out->Width = blob.Surface.Width;
+    Out->Height = blob.Surface.Height;
+    Out->Pitch = blob.Surface.Pitch;
+    Out->DxgiFormat = row->dxgi;
+    Out->D3dDdiFormat = blob.Surface.Format;
+    Out->BindFlags = BC250_SHARED_BIND_SHADER_RESOURCE | BC250_SHARED_BIND_RENDER_TARGET;
+    Out->BytesPerPixel = row->bytes_per_pixel;
+    Out->Size = blob.Surface.Size;
+    Out->MiscFlags = 0;
+    Out->Shared = 1;
+    Out->Access = 0;
+    return BC250_SHARED_SURFACE_OK;
+}
+
 static __inline int Bc250SharedSurfaceDecode(const void *ResourceData, unsigned int ResourceBytes,
                                              const void *AllocationData, unsigned int AllocationBytes,
                                              BC250_SHARED_SURFACE *Out)
diff --git a/driver/contract/test/shared-surface-test.cpp b/driver/contract/test/shared-surface-test.cpp
index 61c2e0d0..e7c96cf7 100644
--- a/driver/contract/test/shared-surface-test.cpp
+++ b/driver/contract/test/shared-surface-test.cpp
@@ -423,6 +423,120 @@ int main() {
         check(composed >= 5 && round_trips >= composed, "every composed row encodes and decodes, with its sRGB view");
     }
 
+    // BD-253 / D3D9On12 bare allocation decode (48-byte GDI1 and 32-byte LB7A v1)
+    {
+        BC250_GDI_PRIVATE gdi{};
+        gdi.Surface.Magic = BC250_WDDM_ALLOCATION_PRIVATE_MAGIC;
+        gdi.Surface.Version = 1;
+        gdi.Surface.Width = 256;
+        gdi.Surface.Height = 254;
+        gdi.Surface.Pitch = 1024;
+        gdi.Surface.Format = 21; // D3DDDIFMT_A8R8G8B8
+        gdi.Surface.Size = 0x40000;
+        gdi.Magic = BC250_GDI_PRIVATE_MAGIC;
+        gdi.Type = 1; // D3DKMDT_GDISURFACE_TEXTURE
+        gdi.Flags = 0;
+        gdi.Reserved = 0;
+
+        BC250_SHARED_SURFACE bare{};
+        const char* why = nullptr;
+        check(Bc250SharedSurfaceDecodeBareAllocation(&gdi, sizeof(gdi), &bare, &why) == BC250_SHARED_SURFACE_OK &&
+                  bare.Width == 256 && bare.Height == 254 && bare.Pitch == 1024 &&
+                  bare.DxgiFormat == 87 /* DXGI_FORMAT_B8G8R8A8_UNORM */ && bare.Shared == 1 &&
+                  (bare.BindFlags & BC250_SHARED_BIND_RENDER_TARGET) &&
+                  (bare.BindFlags & BC250_SHARED_BIND_SHADER_RESOURCE),
+              "bare allocation: 48-byte GDI1 texture decodes with RT and SRV bindings");
+
+        BC250_WDDM_ALLOCATION_PRIVATE lb7a = gdi.Surface;
+        why = nullptr;
+        check(Bc250SharedSurfaceDecodeBareAllocation(&lb7a, sizeof(lb7a), &bare, &why) == BC250_SHARED_SURFACE_OK &&
+                  bare.Width == 256 && bare.Height == 254 && bare.Pitch == 1024 &&
+                  bare.DxgiFormat == 87 /* DXGI_FORMAT_B8G8R8A8_UNORM */,
+              "bare allocation: 32-byte LB7A v1 decodes");
+
+        // Malformed GDI1
+        BC250_GDI_PRIVATE bad_gdi = gdi;
+        bad_gdi.Type = 2; // Staging, not texture
+        check(Bc250SharedSurfaceDecodeBareAllocation(&bad_gdi, sizeof(bad_gdi), &bare, &why) != BC250_SHARED_SURFACE_OK,
+              "bare allocation: non-texture GDI type refused");
+
+        bad_gdi = gdi;
+        bad_gdi.Magic = 0x12345678;
+        check(Bc250SharedSurfaceDecodeBareAllocation(&bad_gdi, sizeof(bad_gdi), &bare, &why) != BC250_SHARED_SURFACE_OK,
+              "bare allocation: bad GDI magic refused");
+
+        check(Bc250SharedSurfaceDecodeBareAllocation(&gdi, sizeof(gdi) - 1, &bare, &why) != BC250_SHARED_SURFACE_OK,
+              "bare allocation: short size refused");
+    }
+
+    // Shared-open layout uses the physical page allocation, not the logical record size.
+    {
+        BC250_SHARED_SURFACE surface{};
+        surface.Pitch = 5632;
+        surface.Size = 4708352; // 1408 padded pixels * 836 rows * 4 bytes
+        unsigned long long allocation = 0;
+        check(Bc250SharedSurfaceLayoutFits(&surface, 5632, 4710400, &allocation) && allocation == 4710400,
+              "layout: partial final page is available to the engine (old comparison refused)");
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 5632, 4710401, &allocation),
+              "layout: one byte beyond the physical allocation is refused");
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 5888, 4710400, &allocation),
+              "layout: page rounding never permits a different row pitch");
+        surface.Size = 4710400;
+        check(Bc250SharedSurfaceLayoutFits(&surface, 5632, 4710400, &allocation) && allocation == surface.Size,
+              "layout: an exact page allocation stays unchanged");
+        surface.Size = 0xffffffffull;
+        check(Bc250SharedSurfaceLayoutFits(&surface, 5632, 0x100000000ull, &allocation) &&
+                  allocation == 0x100000000ull,
+              "layout: UINT32_MAX rounds in 64 bits even in the x86 UMD");
+        surface.Size = ~0ull - 4095ull;
+        check(Bc250SharedSurfaceLayoutFits(&surface, 5632, surface.Size, &allocation) && allocation == surface.Size,
+              "layout: largest non-overflowing page allocation");
+        surface.Size++;
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 5632, 4096, &allocation) && allocation == 0,
+              "layout: page rounding overflow is refused");
+        surface.Size = ~0ull;
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 5632, 4096, &allocation) && allocation == 0,
+              "layout: UINT64_MAX is refused");
+        surface.Size = 0;
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 5632, 4096, &allocation) && allocation == 0,
+              "layout: zero logical bytes are refused");
+        surface.Size = 4096;
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 5632, 0, &allocation),
+              "layout: zero engine backing is refused");
+        surface.Pitch = 0;
+        check(!Bc250SharedSurfaceLayoutFits(&surface, 0, 4096, &allocation),
+              "layout: zero pitches are refused");
+        check(!Bc250SharedSurfaceLayoutFits(nullptr, 256, 4096, &allocation) && allocation == 0,
+              "layout: null surface is refused");
+
+        // Synthetic geometry, not measured RADV output. Sweep both dimensions independently.
+        // Compute the reference page count by division, independently of the production bit mask.
+        for (unsigned axis = 0; axis < 2; ++axis) {
+            bool all_fit = true, all_short_refused = true, all_pitches_refused = true;
+            unsigned rescued = 0;
+            for (unsigned edge = 1; edge <= 2048; ++edge) {
+                const unsigned width = axis == 0 ? edge : 1327;
+                const unsigned height = axis == 0 ? 949 : edge;
+                const unsigned pitch = ((width + 63u) / 64u) * 256u;
+                const unsigned rows = ((height + 3u) / 4u) * 4u;
+                surface.Pitch = pitch;
+                surface.Size = static_cast<unsigned long long>(pitch) * rows;
+                const unsigned long long pages = (surface.Size / 4096 + (surface.Size % 4096 != 0)) * 4096;
+                all_fit &= Bc250SharedSurfaceLayoutFits(&surface, pitch, pages, nullptr) != 0;
+                rescued += pages > surface.Size ? 1u : 0u;
+                all_pitches_refused &= !Bc250SharedSurfaceLayoutFits(&surface, pitch + 256ull, pages, nullptr);
+                surface.Size = pages - 4096;
+                all_short_refused &= !Bc250SharedSurfaceLayoutFits(&surface, pitch, pages, nullptr);
+            }
+            check(all_fit && rescued != 0, axis == 0 ? "horizontal resize: valid rounded layouts admitted"
+                                                    : "vertical resize: valid rounded layouts admitted");
+            check(all_short_refused, axis == 0 ? "horizontal resize: insufficient allocations refused"
+                                              : "vertical resize: insufficient allocations refused");
+            check(all_pitches_refused, axis == 0 ? "horizontal resize: pitch mismatches refused"
+                                               : "vertical resize: pitch mismatches refused");
+        }
+    }
+
     // The count the records quote, printed by the thing that knows it. Three documents disagreed about it before
     // this line existed (44, 48 and 49), because each one was counted by hand (BD-075 review, 2026-10-06).
     std::printf("%u checks, %u failures\n", checks, failures);
