-// ---- Release sequence ------------------------------------------------------------------------------------------
+// Diagnostics compiled into the release UMD: the usual log_line debugger sink
+// is deliberately disabled outside lab flavour. Emit only bounded rare events.
+void log_hangdiag(const char* format, ...) noexcept {
+    const unsigned index = hangdiag_events.fetch_add(1, std::memory_order_relaxed);
+    if (index >= 512) {
+        if (index == 512)
+            OutputDebugStringA("amdgpu_wddm_d3d12 BC250-HANGDIAG further events suppressed (512 per process)\n");
+        return;
+    }
+    char text[384]{};
+    va_list args;
+    va_start(args, format);
+    std::vsnprintf(text, sizeof(text), format, args);
+    va_end(args);
+    LARGE_INTEGER now{};
+    QueryPerformanceCounter(&now);
+    char line[576]{};
+    std::snprintf(line, sizeof(line), "amdgpu_wddm_d3d12 BC250-HANGDIAG pid=%lu tid=%lu qpc=%lld %s\n",
+                  static_cast<unsigned long>(GetCurrentProcessId()),
+                  static_cast<unsigned long>(GetCurrentThreadId()),
+                  static_cast<long long>(now.QuadPart), text);
+    OutputDebugStringA(line);
+}
